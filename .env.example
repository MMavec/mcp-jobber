# Pick ONE of these auth modes

# ---- Mode A: OAuth 2 (recommended for production) ----
# Register an app at https://developer.getjobber.com/ and paste the credentials here.
JOBBER_CLIENT_ID=your_client_id
JOBBER_CLIENT_SECRET=your_client_secret
JOBBER_REFRESH_TOKEN=your_refresh_token
# Optional: override the redirect URI used in the initial auth code exchange
JOBBER_REDIRECT_URI=http://localhost:8976/callback

# ---- Mode B: bearer-token fallback (single-tenant, no auto-refresh) ----
# Jobber does not currently issue "personal access tokens"; this is for any
# bearer access token you have obtained out of band (e.g. a still-valid OAuth
# access token for quick local testing). Used only if JOBBER_REFRESH_TOKEN is empty.
JOBBER_PAT=

# ---- Optional ----
JOBBER_API_URL=https://api.getjobber.com/api/graphql
JOBBER_OAUTH_AUTHORIZE_URL=https://api.getjobber.com/api/oauth/authorize
JOBBER_OAUTH_TOKEN_URL=https://api.getjobber.com/api/oauth/token
# Must be an active version date from developer.getjobber.com/docs/changelog
JOBBER_GRAPHQL_VERSION=2025-04-16
JOBBER_TOKEN_CACHE=~/.cache/mcp-jobber/tokens.json

# Rate limit: Jobber enforces 2500 requests per 5 minutes.
# Leave defaults unless you know what you are doing.
JOBBER_RATE_CAPACITY=2500
JOBBER_RATE_WINDOW_SECONDS=300
